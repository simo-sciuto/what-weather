OPENWEATHER_API_KEY=
# Optional. "openweather" = One Call 4.0 (needs the One Call by Call plan),
# "openweather-free" = Current Weather + 5 day / 3 hour Forecast (free tier),
# "open-meteo" = Open-Meteo, hourly, 8 days, UV (free for non-commercial use, no key;
#   the OpenWeather key, if set, still names places found by location),
# "mock" = sample data. Defaults to "openweather" when a key is set, else "mock".
# WEATHER_PROVIDER=

# Optional. The public address of the site, for absolute share-image URLs
# (e.g. https://meteo.example.com). On Vercel the deployment URL is used by default.
# SITE_URL=

# Optional. Mapbox public token (pk.…) for the maps: the city behind the page and the map chapter
# (without it, neither is shown).
# Restrict it to your domains in the Mapbox account (Tokens > URL restrictions).
# NEXT_PUBLIC_MAPBOX_TOKEN=
